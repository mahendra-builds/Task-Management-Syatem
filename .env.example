# ─── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=task_management
MYSQL_USER=tms
MYSQL_PASSWORD=change-me-tms-password
MYSQL_PORT=3306

# ─── Backend ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
BACKEND_PORT=4000
DATABASE_URL=mysql://tms:change-me-tms-password@mysql:3306/task_management

# Generate with: openssl rand -hex 64
JWT_SECRET=replace-with-strong-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed by CORS
CORS_ORIGIN=http://localhost:8080

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=8080
# When frontend & backend share an origin via reverse proxy, use /api.
# Otherwise: http://localhost:4000/api
VITE_API_BASE_URL=/api
